def _check_raica_server_health(server_url: str, timeout: float = 3.0) -> bool:
    """
    Check if RAICA server is available and healthy.

    Performs a quick health check on the RAICA server.
    If available, RAICA server tools will be offered to the LLM.

    Args:
        server_url: RAICA server base URL
        timeout: Request timeout in seconds

    Returns:
        True if server is healthy, False otherwise
    """
    import urllib.request
    import urllib.error

    health_url = f"{server_url.rstrip('/')}/health"

    try:
        req = urllib.request.Request(health_url, method='GET')
        req.add_header('User-Agent', 'RAICA-Agent/1.0')

        with urllib.request.urlopen(req, timeout=timeout) as response:
            return response.status == 200

    except urllib.error.URLError:
        return False
    except urllib.error.HTTPError:
        return False
    except TimeoutError:
        return False
    except Exception:
        return False


