# Benchmark run output
tests/benchmark/scorecard.json
# Per-run archives (v1.0.0.297): retained LOCALLY for post-hoc variance analysis.
# Not committed -- they are measurements of one machine/session and would accumulate
# without bound. Commit a specific run deliberately when it is evidence for a decision.
tests/benchmark/runs/

# Benchmark engine (override any generic lib/ ignore)
!tests/benchmark/lib/
!tests/benchmark/lib/*.py

# Local/runtime configs + editor & test artifacts — never commit (some carry secrets).
# NOTE: config/communication_hub.yaml (no suffix) IS tracked; only these local variants are ignored.
config/communication_hub.yaml.original
config/communication_hub_newx.yaml
.obsidian/
archive/
tests/data/intent_eval_results.jsonl

# env backups (never commit secrets); .env.example stays tracked
.env.*
!.env.example

# config backups written by config_server_cli / manual edits (e.g.
# config/llm_config.yaml.bak.20260731-095537). They are snapshots of live config
# and can contain values that should never be committed.
*.bak
*.bak.*

# Generated deliverables dropped in the repo ROOT by tool runs (report PDFs etc.).
# Scoped to the root on purpose so real documentation under docs/ stays tracked.
/*.pdf
.deploy_previous_sha
logs/deploy.log
