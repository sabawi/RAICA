# 🚨 CRITICAL PROTECTION: Never ignore these multi-tool calling protection files
!CRITICAL_MULTI_TOOL_CALLING_PROTECTION.md
!verify_multi_tool_calling.sh

# Protected: Keep disabled conflicting tool visible but disabled
!user_tools/_disabled_stock_analyzer.py

# 🚨 CRITICAL SECURITY: NEVER COMMIT SANDBOX WORKSPACE CONTENTS 🚨
# This directory contains user-generated files, personal data, resumes, cover letters,
# and other potentially sensitive information that must NEVER be committed to git
sandbox_workspace/
sandbox_workspace/*
sandbox_workspace/**/*

# Test directory - needs major maintenance and rewriting
test/

# Runtime data files that should not be committed
document_store/faiss.index
watched_directories.json
logs/
runtime/
venv_*/

# Generated/test projects
generated_projects/
.raica/

# Output logs
raica_output_*.txt
*.log

